<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.oracle.database.mcptoolkit</groupId>
    <artifactId>oracle-db-mcp-toolkit-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Oracle Database MCP Toolkit</name>
    <description>The Oracle Database MCP Toolkit is a Model Context Protocol (MCP) server and embeddable runtime for Oracle Database tools.</description>
    <url>https://github.com/oracle/mcp/tree/main/src/oracle-db-mcp-toolkit</url>

    <licenses>
        <license>
            <name>The Universal Permissive License (UPL), Version 1.0</name>
            <url>https://oss.oracle.com/licenses/upl/</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <organization>Oracle Corporation</organization>
            <organizationUrl>https://www.oracle.com</organizationUrl>
        </developer>
    </developers>

    <modules>
        <module>core</module>
        <module>standalone</module>
        <module>spring-boot-starter</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <mcp.version>0.18.4</mcp.version>
        <ojdbc.version>23.26.2.0.0</ojdbc.version>
        <snakeYaml.version>2.5</snakeYaml.version>
        <logAnalyzer.version>1.0.0</logAnalyzer.version>
        <tomcat.version>11.0.22</tomcat.version>
        <spring-boot.version>3.4.4</spring-boot.version>
        <junit.version>5.10.0</junit.version>
        <nimbus-jose-jwt.version>10.6</nimbus-jose-jwt.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
</project>
